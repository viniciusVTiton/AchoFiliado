# Copie para .env e preencha. O .env nunca vai para o navegador.
PORT=3000

# Amazon Associados: sua tag (ex.: viniachados0a-20)
AMAZON_TAG=

# Shopee Affiliate Open Platform: https://affiliate.shopee.com.br/open_api
SHOPEE_APP_ID=
SHOPEE_SECRET=
# Opcional: aparece nos relatórios da Shopee (ex.: nome do grupo)
SHOPEE_SUB_ID=

# Mercado Livre: etiqueta do Gerador de links (os links sao gerados pela extensao do Chrome)
ML_TAG=
