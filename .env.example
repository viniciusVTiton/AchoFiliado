# Copie este arquivo para .env e preencha. O .env não vai para o git.

# Amazon: tag de associado (Store ID)
AMAZON_TAG=viniachados0a-20

# Shopee Affiliate Open Platform (affiliate.shopee.com.br -> Open API)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
# Opcional: até 5 sub IDs separados por vírgula, para rastrear a origem das vendas
SHOPEE_SUB_IDS=achofiliado

PORT=3000
